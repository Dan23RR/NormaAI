# ===========================================================================
# NormaAI - Environment Configuration
# ===========================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required variables are marked with [REQUIRED].
# All other variables have sensible defaults for local development.
# ===========================================================================

# ─── Application ──────────────────────────────────────────────────
# [REQUIRED] Application secret key (min 64 chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
APP_SECRET_KEY=

# Environment: development | staging | production
APP_ENV=development

# Comma-separated CORS origins
CORS_ORIGINS=http://localhost:3000

# ─── LLM Provider ────────────────────────────────────────────────
# Choose provider: gemini | anthropic | openrouter
LLM_PROVIDER=gemini

# [REQUIRED - pick one] Google Gemini API key
GOOGLE_API_KEY=

# Anthropic API key (required only if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# OpenRouter (OpenAI-compatible gateway, https://openrouter.ai/keys).
# Useful for real-LLM testing on free-tier models and as a BYO-key path.
# Requires the extra:  poetry install -E openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ANALYSIS=nvidia/nemotron-3-super-120b-a12b:free

# LLM model names (defaults shown). Also read as GEMINI_MODEL_ANALYSIS and
# ANTHROPIC_MODEL_ANALYSIS. Claude 5 models take no `temperature`: NormaAI
# leaves it out for them.
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_MODEL=claude-sonnet-5-5

# ─── Database (PostgreSQL) ────────────────────────────────────────
# [REQUIRED for docker compose] Postgres superuser password for the
# bundled postgres service (compose refuses to start without it).
POSTGRES_PASSWORD=

# PostgreSQL async connection string
DATABASE_URL=postgresql+asyncpg://normaai:normaai_dev_pw@localhost:5432/normaai

# Sync variant (for Alembic migrations)
DATABASE_URL_SYNC=postgresql://normaai:normaai_dev_pw@localhost:5432/normaai

# Multi-tenant RLS (production): by default the app connects as `normaai`, the
# Postgres SUPERUSER/owner, which BYPASSES Row-Level Security - so tenant
# isolation is application-level only. To enforce RLS at the database, run
# scripts/setup_app_role.sql once on the live DB (creates the NON-superuser
# `normaai_app` role + the missing INSERT policies), then deploy with the RLS
# overlay and set the role password here:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#     -f docker-compose.rls.yml up -d
# Validate two-tenant isolation on staging first - see docs/DEPLOY_READINESS.md.
APP_DB_PASSWORD=

# ─── Vector Database (Qdrant) ────────────────────────────────────
# The compose files publish Qdrant on 127.0.0.1 only. "localhost" works too, but on
# Windows it tries IPv6 (::1) first and every request then waits about 2 s.
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
# Collection searched by the API and written by the seed. Must have been built
# with EMBEDDING_MODEL below (an A/B test points both at a re-embedded copy).
QDRANT_COLLECTION=eu_regulations

# Embedding model - multilingual by default (IT+EN legal corpus & queries).
# Switching models requires re-seeding the corpus (see ADR-006) or re-embedding
# it with scripts/reembed_collection.py; candidates in docs/MODELS.md.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# Optional cross-encoder reranker, off while RERANKER_MODEL_DIR is empty. The
# directory holds an ONNX export of the model (RERANKER_ONNX_FILE, relative to
# it) and its tokenizer.json; the API refuses to start if they cannot be loaded.
# Measurements and licence notes in docs/MODELS.md, section 4.
RERANKER_MODEL_DIR=
RERANKER_ONNX_FILE=model.onnx
RERANKER_CANDIDATES=30
# Dense and sparse results fused into the candidates: 90 with mpnet, 45 with
# multilingual-e5-large (docs/MODELS.md, section 4.1).
RERANKER_SEARCH_DEPTH=90

# ─── Cache & Token Store (Redis) ─────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# Cache TTL in seconds (default: 1 hour)
CACHE_TTL_SECONDS=3600

# ─── Authentication (JWT RS256) ──────────────────────────────────
# Path to RSA key files. Generate with:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
JWT_PRIVATE_KEY_PATH=jwt_private.pem
JWT_PUBLIC_KEY_PATH=jwt_public.pem

# Token TTL (seconds)
ACCESS_TOKEN_TTL=900        # 15 minutes
REFRESH_TOKEN_TTL=604800    # 7 days

# ─── Registration & account security ─────────────────────────────
# invite (default) | open | closed. In invite mode bootstrap the first admin
# with: python scripts/create_invite.py --email founder@example.com
REGISTRATION_MODE=invite

# Require a confirmed email before using the intelligence endpoints
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=48

# NormaAI staff (comma-separated or JSON list): corpus crawl/re-index and
# invites that create new organizations. Matched on the token's email claim.
STAFF_EMAILS=

# Per-IP limits on the public auth endpoints ("<count>/<period>")
AUTH_RATE_LIMIT_REGISTER=5/hour
AUTH_RATE_LIMIT_LOGIN=10/minute
AUTH_RATE_LIMIT_REFRESH=30/minute
AUTH_RATE_LIMIT_VERIFICATION=10/hour

# Daily LLM requests per organization across qa/gap-analysis/monitor (0 = unlimited)
LLM_DAILY_QUOTA_PER_ORG=200

# ─── EUR-Lex Crawler ─────────────────────────────────────────────
EURLEX_SPARQL_ENDPOINT=https://publications.europa.eu/webapi/rdf/sparql

# Background refresh loop ("updated nightly"). OFF by default; set true on a
# SINGLE process/replica that should own the periodic EUR-Lex/Normattiva sync.
ACQUISITION_SCHEDULER_ENABLED=false

# ─── Normattiva (Italian Legislation) ────────────────────────────
NORMATTIVA_API_BASE_URL=https://www.normattiva.it/opendata

# Data source for seeding: eurlex | normattiva | both
# "both" (the code default) also ingests Italian transposition law from
# Normattiva (best-effort); "eurlex" gives EU-level text only (no Italian law).
DATA_SOURCE=both

# As-of date of the indexed corpus (ISO YYYY-MM-DD). Set to your last seed date
# so API metadata and PDF report footers show how fresh the underlying law is.
CORPUS_AS_OF=

# ─── Logging ─────────────────────────────────────────────────────
# Level for the root, uvicorn and structlog loggers. The audit trail (logger
# normaai.audit) is always emitted at INFO, whatever the level set here.
LOG_LEVEL=INFO
# Output format: plain (human-readable, one consistent line format for app and
# uvicorn logs) | json (one JSON object per line, for log collectors)
LOG_FORMAT=plain

# ─── Observability (optional) ────────────────────────────────────
# OpenTelemetry OTLP endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Sentry DSN (optional - error tracking with the FastAPI integration).
# Requires the optional extra:  poetry install -E sentry
SENTRY_DSN=

# [REQUIRED for docker compose] Grafana admin password (no default -
# compose refuses to start the grafana service without it).
GRAFANA_PASSWORD=

# Bearer token protecting /api/v1/metrics/prometheus (scrape auth).
PROMETHEUS_BEARER_TOKEN=

# ─── SNC Trust Layer (optional, OFF by default) ───────────────────
# K-sample behavioral trust clustering (ADR-6). Costs K-1 extra LLM calls per
# request; a failed resample batch degrades into an abstention. Opt in per deploy.
SNC_ENABLED=false
# SNC_K=3
# SNC_TEMPERATURE=0.7
# SNC_THETA_HIGH=0.85
# SNC_THETA_LOW=0.50

# ─── Citation verification ───────────────────────────────────────
# Every Q&A quote is checked word for word against the retrieved texts
# (ARCHITECTURE.md, "Verifica deterministica delle citazioni"). When an answer
# has citations and none is verified: "flag" serves it for expert review with
# capped confidence and a caveat; "strict" abstains (unverified_citations).
CITATION_VERIFICATION=flag

# ─── Local LLM Router (optional) ─────────────────────────────────
# Enable the local LLM for fast framework classification
LOCAL_LLM_ENABLED=false
LOCAL_LLM_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
LOCAL_LLM_MAX_TOKENS=256

# ─── Rate Limiting ───────────────────────────────────────────────
# Default global rate limit
RATE_LIMIT_DEFAULT=100/minute

# ─── Development ─────────────────────────────────────────────────
# Disable rate limiting in dev
# RATE_LIMIT_ENABLED=false

# Enable debug logging (see the Logging section above)
# LOG_LEVEL=DEBUG

# ─── Public URL (for tracking links in emails) ───────────────────
# Used by email_client to build absolute URLs (Codex download, unsubscribe)
NORMAAI_PUBLIC_URL=https://normaai.org

# ─── Resend (transactional email outbound) ───────────────────────
# Free tier: 3000 email/month, 100/day. DKIM auto-configured per domain.
# Get key at: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@normaai.org
RESEND_FROM_NAME=NormaAI
RESEND_REPLY_TO=info@normaai.org

# Resend webhook signing secret (for open/click tracking)
RESEND_WEBHOOK_SECRET=
